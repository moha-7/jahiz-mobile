{
  "name": "safaryaty-backend",
  "version": "4.29.52.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "start": "node scripts/run-built-server.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test:health": "tsx src/scripts/health-check.ts",
    "test:external": "node scripts/run-external-tests.mjs",
    "db:backfill:finance-profile": "tsx scripts/backfill-trip-finance-profiles.ts",
    "db:backfill:finance-profile:dry": "tsx scripts/backfill-trip-finance-profiles.ts --dry-run",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:postgres:audit": "node scripts/audit-postgresql-readiness.mjs",
    "prisma:postgres:validate": "prisma validate --schema prisma/postgresql/schema.prisma",
    "prisma:postgres:generate": "prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:postgres:baseline:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/postgresql/schema.prisma --script --output prisma/postgresql/baseline.generated.sql",
    "prisma:postgres:migrate:deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:migration:bundle:export": "node scripts/export-postgresql-migration-bundle.mjs",
    "db:migration:bundle:export:sessions": "node scripts/export-postgresql-migration-bundle.mjs --include-sessions",
    "db:migration:bundle:verify": "node scripts/verify-postgresql-migration-bundle.mjs",
    "db:postgres:target:verify": "node scripts/verify-postgresql-target.mjs",
    "db:postgres:staging:import": "node scripts/import-postgresql-staging.mjs",
    "db:postgres:staging:receipt:verify": "node scripts/verify-postgresql-staging-receipt.mjs",
    "db:postgres:staging:smoke": "tsx scripts/postgresql-staging-smoke.ts",
    "db:cutover:source:backup": "node scripts/backup-sqlite-cutover-source.mjs",
    "db:rollback:sqlite:verify": "node scripts/verify-sqlite-rollback.mjs",
    "dev:postgres:staging": "node scripts/run-postgresql-staging.mjs --dev",
    "start:postgres:staging": "node scripts/run-postgresql-staging.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.3",
    "helmet": "7.1.0",
    "morgan": "1.10.0",
    "multer": "2.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/morgan": "1.9.9",
    "@types/multer": "2.0.0",
    "@types/node": "22.10.2",
    "prisma": "6.15.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
