NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER=sqlite
APP_ORIGIN="http://127.0.0.1:5173"
SESSION_COOKIE_NAME="safaryaty_session"
SESSION_DAYS=30
UPLOAD_DIR="uploads"
COOKIE_SAMESITE="lax"

REST_COUNTRIES_BASE_URL="https://restcountries.com/v3.1"
REST_COUNTRIES_API_KEY=""
COUNTRY_METADATA_TTL_HOURS=168

FRANKFURTER_BASE_URL="https://api.frankfurter.dev"
FX_RATE_TTL_HOURS=24

# PostgreSQL staging target (v4.29.51). SQLite remains active unless DATABASE_PROVIDER=postgresql.
POSTGRES_DATABASE_URL="postgresql://safaryaty:CHANGE_ME@127.0.0.1:5432/safaryaty_staging?schema=public"
# Staging cutover only — uncomment after a verified import receipt exists.
# POSTGRES_TARGET_KIND=staging
# POSTGRES_STAGING_ACK=SAFARYATY_POSTGRES_STAGING_VERIFIED
# POSTGRES_VERIFICATION_RECEIPT="./migration-reports/verified-receipt.json"
